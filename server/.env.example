# Copie ce fichier en .env et remplis tes vraies valeurs.
# Le fichier .env ne doit JAMAIS être envoyé sur GitHub.

# Port du serveur
PORT=3001

# Le compte Gmail qui ENVOIE les emails
MAIL_USER=ton.adresse@gmail.com

# Le mot de passe d'application Gmail (16 caractères, sans espaces)
MAIL_PASS=xxxxxxxxxxxxxxxx

# L'adresse qui REÇOIT les demandes de contact
MAIL_TO=ton.adresse@gmail.com

# --- Sécurité : à remplir pour la mise en ligne (à laisser vides sur ton ordinateur) ---

# Les sites autorisés à appeler l'API, séparés par des virgules, sans « / » à la fin.
# Exemple : CORS_ORIGIN=https://ton-site.fr
# Vide = aucun filtrage (pratique en développement, à ne jamais laisser vide en ligne).
CORS_ORIGIN=

# Le nombre d'intermédiaires (« proxys ») entre les visiteurs et le serveur :
# vide ou 0 sur ton ordinateur, 1 chez la plupart des hébergeurs.
TRUST_PROXY=

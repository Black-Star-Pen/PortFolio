# Copie ce fichier en .env et remplis tes vraies valeurs.
# Le fichier .env ne doit JAMAIS être envoyé sur GitHub.

# Port du serveur
PORT=3001
NODE_ENV=development

# Le compte Gmail qui ENVOIE les emails
MAIL_USER=ton.adresse@gmail.com

# Le mot de passe d'application Gmail (16 caractères, sans espaces)
MAIL_PASS=xxxxxxxxxxxxxxxx

# L'adresse qui REÇOIT les demandes de contact
MAIL_TO=ton.adresse@gmail.com

# --- Envoi par Resend, en local comme en ligne ---

# La clé de ton compte Resend. Dès qu'elle est remplie, les emails partent par Resend et plus par Gmail.
RESEND_API_KEY=

# L'expéditeur des emails envoyés par Resend. Vide = l'adresse de test de Resend
# (tests uniquement vers l'adresse associée au compte Resend).
MAIL_FROM=

# --- Sécurité : valeurs locales ci-dessous, à adapter chez l'hébergeur ---

# Les sites autorisés à appeler l'API, séparés par des virgules, sans « / » à la fin.
# Exemple : CORS_ORIGIN=https://ton-site.fr
# Vide en développement = localhost:5173 et 127.0.0.1:5173 uniquement.
# Obligatoire avec NODE_ENV=production ; utilise alors l'origine HTTPS du site.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Le nombre d'intermédiaires (« proxys ») entre les visiteurs et le serveur :
# vide ou 0 sur ton ordinateur, 3 chez Render (valeur mesurée, voir render.yaml).
TRUST_PROXY=0

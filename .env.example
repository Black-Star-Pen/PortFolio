# Clé PUBLIQUE du widget Turnstile (Cloudflare → Turnstile).
# En développement, vide = clé de test officielle ; en production, renseigner la vraie clé.
VITE_TURNSTILE_SITE_KEY=

# Facultatif en local : Vite transmet /api au serveur sur le port 3001.
# En production, renseigner l'adresse de l'API.
VITE_API_URL=
